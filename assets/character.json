{
  "version": 2,
  "id": "wisp-painted",
  "renderer": "painted-wisp / Canvas 2D",
  "manifest": "assets/wisp/asset-manifest.json",
  "canvas": [
    1024,
    1536
  ],
  "phonemeMap": {},
  "speechShapes": {
    "rest": "rest",
    "MBP": "mbp",
    "FV": "fv",
    "A": "aa",
    "E": "ee",
    "O": "oh",
    "U": "oo",
    "L": "l",
    "TH": "th",
    "CH": "ch",
    "S": "ss"
  },
  "forms": {
    "friendly": "supplied paintings",
    "evil": "not supplied",
    "transformation": "not supplied"
